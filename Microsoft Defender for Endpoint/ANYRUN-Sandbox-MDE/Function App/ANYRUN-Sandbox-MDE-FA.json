{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "functionAppName": {
      "type": "string",
      "defaultValue": "ANYRUN-Sandbox-MDE-FA"
    },
    "hostingPlanName": {
      "type": "string",
      "defaultValue": "[parameters('functionAppName')]",
      "metadata": {
        "description": "Flex Consumption plan name. Defaults to the Function App name."
      }
    },
    "appInsightsName": {
      "type": "string",
      "defaultValue": "[parameters('functionAppName')]",
      "metadata": {
        "description": "Application Insights name. Defaults to the Function App name."
      }
    },
    "packageUri": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com/yaestkit/anyrun-integration-microsoft/refs/heads/asyncv2/Microsoft%20Defender%20for%20Endpoint/ANYRUN-Sandbox-MDE/Function%20App/ANYRUN-Sandbox-MDE-FA.zip",
      "metadata": {
        "description": "HTTPS URI of the Function App ZIP package."
      }
    },
    "AzureTenantID": {
      "type": "string",
      "metadata": {
        "description": "Azure Tenant ID for authentication."
      }
    },
    "AzureClientID": {
      "type": "string",
      "metadata": {
        "description": "Azure Client ID for authentication."
      }
    },
    "AzureClientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Azure Client Secret for authentication."
      }
    },
    "AzureStorageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Azure Blob Storage Account Name."
      }
    },
    "AzureStorageAccountKey": {
      "type": "securestring",
      "metadata": {
        "description": "Azure Blob Storage Account Key."
      }
    },
    "AzureStorageConnectionString": {
      "type": "securestring",
      "metadata": {
        "description": "Azure Blob Storage Account Connection string."
      }
    },
    "AzureBlobContainerName": {
      "type": "string",
      "defaultValue": "anyrun-quarantine",
      "metadata": {
        "description": "Azure Blob Storage Container Name."
      }
    },
    "ANYRUN_API_KEY": {
      "type": "securestring",
      "metadata": {
        "description": "API Key of your ANY.RUN Account."
      }
    },
    "DefenderIndicatorAction": {
      "type": "string",
      "defaultValue": "Audit",
      "allowedValues": [
        "Audit",
        "Block",
        "Disabled"
      ],
      "metadata": {
        "description": "Defender action for IOCs found by ANY.RUN Sandbox: Audit (alert on match), Block, or Disabled (do not import IOCs; they stay in alert comments)."
      }
    },
    "ConfigureEvidenceLifecyclePolicy": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Create lifecycle cleanup rules: evidence after one day and asynchronous job status after seven days. Enable only for a dedicated Storage Account because Azure has one lifecycle policy document per account."
      }
    },
    "LogAnalyticsWorkspaceName": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics Workspace Name."
      }
    }
  },
  "variables": {
    "deploymentStorageContainerName": "anyrundeploymentcontainer",
    "jobStatusContainerName": "anyrun-job-status",
    "storageRoleDefinitionId": "ba92f5b4-2d11-453d-a403-e96b0029c9fe"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[parameters('appInsightsName')]",
      "location": "[resourceGroup().location]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "ApplicationId": "[parameters('functionAppName')]",
        "WorkspaceResourceId": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.OperationalInsights/workspaces/', parameters('LogAnalyticsWorkspaceName'))]"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[parameters('AzureStorageAccountName')]",
      "location": "[resourceGroup().location]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "defaultToOAuthAuthentication": true,
        "allowBlobPublicAccess": false,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/{1}', parameters('AzureStorageAccountName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('AzureStorageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/{1}/{2}', parameters('AzureStorageAccountName'), 'default', variables('deploymentStorageContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices',  parameters('AzureStorageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/{1}/{2}', parameters('AzureStorageAccountName'), 'default', parameters('AzureBlobContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices',  parameters('AzureStorageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/{1}/{2}', parameters('AzureStorageAccountName'), 'default', variables('jobStatusContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('AzureStorageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/managementPolicies",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', parameters('AzureStorageAccountName'), 'default')]",
      "condition": "[parameters('ConfigureEvidenceLifecyclePolicy')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('AzureStorageAccountName'), 'default', parameters('AzureBlobContainerName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('AzureStorageAccountName'), 'default', variables('jobStatusContainerName'))]"
      ],
      "properties": {
        "policy": {
          "rules": [
            {
              "enabled": true,
              "name": "delete-anyrun-evidence-after-one-day",
              "type": "Lifecycle",
              "definition": {
                "actions": {
                  "baseBlob": {
                    "delete": {
                      "daysAfterModificationGreaterThan": 1
                    }
                  }
                },
                "filters": {
                  "blobTypes": [
                    "blockBlob"
                  ],
                  "prefixMatch": [
                    "[concat(parameters('AzureBlobContainerName'), '/')]"
                  ]
                }
              }
            },
            {
              "enabled": true,
              "name": "delete-anyrun-job-status-after-seven-days",
              "type": "Lifecycle",
              "definition": {
                "actions": {
                  "baseBlob": {
                    "delete": {
                      "daysAfterModificationGreaterThan": 7
                    }
                  }
                },
                "filters": {
                  "blobTypes": [
                    "blockBlob"
                  ],
                  "prefixMatch": [
                    "[concat(variables('jobStatusContainerName'), '/')]"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[parameters('hostingPlanName')]",
      "location": "[resourceGroup().location]",
      "kind": "functionapp",
      "sku": {
        "tier": "FlexConsumption",
        "name": "FC1"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-11-01",
      "name": "[parameters('functionAppName')]",
      "location": "[resourceGroup().location]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "httpsOnly": true,
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]",
        "functionAppConfig": {
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "[concat(reference(resourceId('Microsoft.Storage/storageAccounts', parameters('AzureStorageAccountName'))).primaryEndpoints.blob, variables('deploymentStorageContainerName'))]",
              "authentication": {
                "type": "SystemAssignedIdentity"
              }
            }
          },
          "scaleAndConcurrency": {
            "maximumInstanceCount": 5,
            "instanceMemoryMB": 4096
          },
          "runtime": {
            "name": "python",
            "version": "3.12"
          }
        },
        "siteConfig": {
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "ANYRUN_API_KEY",
              "value": "[concat('API-KEY ', parameters('ANYRUN_API_KEY'))]"
            },
            {
              "name": "DefenderIndicatorAction",
              "value": "[parameters('DefenderIndicatorAction')]"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02').InstrumentationKey]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02').ConnectionString]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[parameters('AzureStorageConnectionString')]"
            },            
            {
              "name": "AzureBlobContainerName",
              "value": "[parameters('AzureBlobContainerName')]"
            },
            {
              "name": "AnyRunJobStatusContainerName",
              "value": "[variables('jobStatusContainerName')]"
            },
            {
              "name": "AzureClientID",
              "value": "[parameters('AzureClientID')]"
            },
            {
              "name": "AzureClientSecret",
              "value": "[parameters('AzureClientSecret')]"
            },
            {
              "name": "AzureStorageAccountKey",
              "value": "[parameters('AzureStorageAccountKey')]"
            },
            {
              "name": "AzureStorageAccountName",
              "value": "[parameters('AzureStorageAccountName')]"
            },
            {
              "name": "AzureStorageConnectionString",
              "value": "[parameters('AzureStorageConnectionString')]"
            },
            {
              "name": "AzureTenantID",
              "value": "[parameters('AzureTenantID')]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('AzureStorageAccountName'))]",
        "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2024-04-01",
      "name": "[format('{0}/{1}', parameters('functionAppName'), 'ftp')]",
      "properties": {
        "allow": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2024-04-01",
      "name": "[format('{0}/{1}', parameters('functionAppName'), 'scm')]",
      "properties": {
        "allow": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "AssignFunctionStorageRole",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "storageAccountName": {
            "value": "[parameters('AzureStorageAccountName')]"
          },
          "principalId": {
            "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2024-11-01', 'Full').identity.principalId]"
          },
          "storageRoleDefinitionId": {
            "value": "[variables('storageRoleDefinitionId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "storageAccountName": {
              "type": "string"
            },
            "principalId": {
              "type": "string"
            },
            "storageRoleDefinitionId": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), parameters('principalId'), parameters('storageRoleDefinitionId'))]",
              "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('storageRoleDefinitionId'))]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('AzureStorageAccountName'))]",
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/extensions",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}/{1}', parameters('functionAppName'), 'onedeploy')]",
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'AssignFunctionStorageRole')]"
      ],
      "properties": {
        "packageUri": "[parameters('packageUri')]",
        "remoteBuild": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices",
      "apiVersion": "2019-06-01",
      "name": "[concat(parameters('AzureStorageAccountName'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', tolower(parameters('AzureStorageAccountName')))]"
      ],
      "sku": {
        "name": "Standard_LRS",
        "tier": "Standard"
      },
      "properties": {
        "cors": {
          "corsRules": []
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2019-06-01",
      "name": "[concat(parameters('AzureStorageAccountName'), '/default/', tolower(parameters('AzureStorageAccountName')))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices', parameters('AzureStorageAccountName'), 'default')]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('AzureStorageAccountName'))]"
      ],
      "properties": {
        "shareQuota": 5120
      }
    }
  ]
}
