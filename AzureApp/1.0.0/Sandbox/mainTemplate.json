{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ANY.RUN Sandbox for Microsoft Defender for Endpoint: Function App (starter, queue worker, status) + Logic App that detonates files and URLs from new MDE alerts in ANY.RUN and enriches the alerts."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "instanceName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 12,
      "metadata": {
        "description": "Instance name (up to 12 lowercase letters and digits) used in the names of all resources of this deployment. A new value creates a new instance; an existing value updates that instance."
      }
    },
    "evidenceContainerName": {
      "type": "string",
      "defaultValue": "anyrun-quarantine",
      "minLength": 3,
      "maxLength": 63,
      "metadata": {
        "description": "Private blob container where Live Response uploads evidence files."
      }
    },
    "configureEvidenceLifecyclePolicy": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Delete orphan evidence after one day and job status after seven days. Safe because the Storage Account is dedicated to this connector."
      }
    },
    "logAnalyticsWorkspaceResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of an existing Log Analytics workspace for Application Insights. Leave empty to create a new workspace."
      }
    },
    "anyrunApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "ANY.RUN API key (without the 'API-KEY ' prefix)."
      }
    },
    "analysisPrivacyType": {
      "type": "string",
      "defaultValue": "bylink",
      "allowedValues": [
        "bylink",
        "owner"
      ],
      "metadata": {
        "description": "Specify the visibility of analysis results."
      }
    },
    "azureTenantId": {
      "type": "string",
      "defaultValue": "[subscription().tenantId]",
      "metadata": {
        "description": "Microsoft Entra tenant ID where the Defender for Endpoint app registration lives."
      }
    },
    "azureClientId": {
      "type": "string",
      "metadata": {
        "description": "Application (client) ID of the app registration with WindowsDefenderATP permissions."
      }
    },
    "azureClientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Client secret of the app registration."
      }
    },
    "defenderIndicatorAction": {
      "type": "string",
      "defaultValue": "Audit",
      "allowedValues": [
        "Audit",
        "Block",
        "Disabled"
      ],
      "metadata": {
        "description": "Defender action for IOCs found by ANY.RUN Sandbox: Audit (alert on match), Block, or Disabled (do not import IOCs; they stay in alert comments)."
      }
    },
    "_artifactsLocation": {
      "type": "string",
      "defaultValue": "[deployment().properties.templateLink.uri]",
      "metadata": {
        "description": "Base URI where artifacts required by this template are located."
      }
    },
    "_artifactsLocationSasToken": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "SAS token to access _artifactsLocation (supplied automatically by the Marketplace)."
      }
    }
  },
  "variables": {
    "baseName": "[if(empty(parameters('instanceName')), 'anyrun-sandbox-mde', concat('ANYRUN-Sandbox-MDE-', parameters('instanceName')))]",
    "nameHash": "[if(empty(parameters('instanceName')), uniqueString(resourceGroup().id), take(uniqueString(resourceGroup().id, parameters('instanceName')), 6))]",
    "functionAppName": "[if(empty(parameters('instanceName')), concat(variables('baseName'), '-', variables('nameHash')), concat(variables('baseName'), '-', variables('nameHash'), '-FA'))]",
    "hostingPlanName": "[if(empty(parameters('instanceName')), variables('functionAppName'), concat(variables('baseName'), '-Plan'))]",
    "appInsightsName": "[if(empty(parameters('instanceName')), variables('functionAppName'), concat(variables('baseName'), '-AI'))]",
    "newWorkspaceName": "[if(empty(parameters('instanceName')), concat(variables('functionAppName'), '-law'), concat(variables('baseName'), '-LAW'))]",
    "logicAppName": "[if(empty(parameters('instanceName')), 'ANYRUN-Sandbox-MDE-LA', concat(variables('baseName'), '-LA'))]",
    "storageAccountName": "[take(concat('anyrunsb', variables('nameHash'), parameters('instanceName')), 24)]",
    "wdatpConnectionName": "[if(empty(parameters('instanceName')), 'wdatp--anyrun-app', concat(variables('baseName'), '-WDATP'))]",
    "createWorkspace": "[empty(parameters('logAnalyticsWorkspaceResourceId'))]",
    "workspaceResourceId": "[if(variables('createWorkspace'), resourceId('Microsoft.OperationalInsights/workspaces', variables('newWorkspaceName')), parameters('logAnalyticsWorkspaceResourceId'))]",
    "deploymentContainerName": "anyrundeploymentcontainer",
    "jobStatusContainerName": "anyrun-job-status",
    "storageBlobDataContributorRoleId": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
    "wdatpApiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'wdatp')]",
    "functionPackageUri": "[uri(parameters('_artifactsLocation'), concat('artifacts/ANYRUN-Sandbox-MDE-FA.zip', parameters('_artifactsLocationSasToken')))]",
    "resourceTags": {
      "Vendor": "ANY.RUN",
      "Solution": "ANY.RUN Sandbox for Microsoft Defender for Endpoint",
      "Instance": "[if(empty(parameters('instanceName')), 'default', parameters('instanceName'))]"
    }
  },
  "resources": [
    {
      "condition": "[variables('createWorkspace')]",
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2025-07-01",
      "name": "[variables('newWorkspaceName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('newWorkspaceName'))]"
      ],
      "tags": "[variables('resourceTags')]",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[variables('workspaceResourceId')]"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2025-06-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "tags": "[variables('resourceTags')]",
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "defaultToOAuthAuthentication": true,
        "allowBlobPublicAccess": false,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', variables('deploymentContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', parameters('evidenceContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', variables('jobStatusContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "condition": "[parameters('configureEvidenceLifecyclePolicy')]",
      "type": "Microsoft.Storage/storageAccounts/managementPolicies",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', parameters('evidenceContainerName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', variables('jobStatusContainerName'))]"
      ],
      "properties": {
        "policy": {
          "rules": [
            {
              "enabled": true,
              "name": "delete-anyrun-evidence-after-one-day",
              "type": "Lifecycle",
              "definition": {
                "actions": {
                  "baseBlob": {
                    "delete": {
                      "daysAfterModificationGreaterThan": 1
                    }
                  }
                },
                "filters": {
                  "blobTypes": [
                    "blockBlob"
                  ],
                  "prefixMatch": [
                    "[concat(parameters('evidenceContainerName'), '/')]"
                  ]
                }
              }
            },
            {
              "enabled": true,
              "name": "delete-anyrun-job-status-after-seven-days",
              "type": "Lifecycle",
              "definition": {
                "actions": {
                  "baseBlob": {
                    "delete": {
                      "daysAfterModificationGreaterThan": 7
                    }
                  }
                },
                "filters": {
                  "blobTypes": [
                    "blockBlob"
                  ],
                  "prefixMatch": [
                    "[concat(variables('jobStatusContainerName'), '/')]"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2025-05-01",
      "name": "[variables('hostingPlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "tier": "FlexConsumption",
        "name": "FC1"
      },
      "kind": "functionapp",
      "tags": "[variables('resourceTags')]",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2025-05-01",
      "name": "[variables('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', variables('deploymentContainerName'))]",
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]"
      ],
      "tags": "[variables('resourceTags')]",
      "properties": {
        "httpsOnly": true,
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "functionAppConfig": {
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "[concat(reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2025-06-01').primaryEndpoints.blob, variables('deploymentContainerName'))]",
              "authentication": {
                "type": "SystemAssignedIdentity"
              }
            }
          },
          "scaleAndConcurrency": {
            "maximumInstanceCount": 5,
            "instanceMemoryMB": 4096
          },
          "runtime": {
            "name": "python",
            "version": "3.12"
          }
        },
        "siteConfig": {
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "ANYRUN_API_KEY",
              "value": "[concat('API-KEY ', parameters('anyrunApiKey'))]"
            },
            {
              "name": "DefenderIndicatorAction",
              "value": "[parameters('defenderIndicatorAction')]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2025-06-01').keys[0].value)]"
            },
            {
              "name": "AzureBlobContainerName",
              "value": "[parameters('evidenceContainerName')]"
            },
            {
              "name": "AnyRunJobStatusContainerName",
              "value": "[variables('jobStatusContainerName')]"
            },
            {
              "name": "AzureClientID",
              "value": "[parameters('azureClientId')]"
            },
            {
              "name": "AzureClientSecret",
              "value": "[parameters('azureClientSecret')]"
            },
            {
              "name": "AzureStorageAccountKey",
              "value": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2025-06-01').keys[0].value]"
            },
            {
              "name": "AzureStorageAccountName",
              "value": "[variables('storageAccountName')]"
            },
            {
              "name": "AzureStorageConnectionString",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2025-06-01').keys[0].value)]"
            },
            {
              "name": "AzureTenantID",
              "value": "[parameters('azureTenantId')]"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', variables('functionAppName'), 'ftp')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]"
      ],
      "properties": {
        "allow": false
      }
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', variables('functionAppName'), 'scm')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]"
      ],
      "properties": {
        "allow": false
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[take(concat('StorageRole-', variables('functionAppName')), 64)]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
        "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]"
      ],
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "storageAccountName": {
            "value": "[variables('storageAccountName')]"
          },
          "principalId": {
            "value": "[reference(resourceId('Microsoft.Web/sites', variables('functionAppName')), '2025-05-01', 'Full').identity.principalId]"
          },
          "roleDefinitionName": {
            "value": "[variables('storageBlobDataContributorRoleId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "storageAccountName": {
              "type": "string"
            },
            "principalId": {
              "type": "string"
            },
            "roleDefinitionName": {
              "type": "string"
            }
          },
          "resources": [
            {
              "scope": "[format('Microsoft.Storage/storageAccounts/{0}', parameters('storageAccountName'))]",
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), parameters('principalId'), parameters('roleDefinitionName'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('roleDefinitionName'))]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/extensions",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', variables('functionAppName'), 'onedeploy')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]",
        "[resourceId('Microsoft.Resources/deployments', take(concat('StorageRole-', variables('functionAppName')), 64))]",
        "[resourceId('Microsoft.Web/sites/basicPublishingCredentialsPolicies', variables('functionAppName'), 'scm')]"
      ],
      "properties": {
        "packageUri": "[variables('functionPackageUri')]",
        "remoteBuild": true
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('wdatpConnectionName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]",
      "properties": {
        "displayName": "[variables('wdatpConnectionName')]",
        "api": {
          "id": "[variables('wdatpApiId')]"
        },
        "parameterValues": {
          "token:tenantId": "[parameters('azureTenantId')]",
          "token:clientId": "[parameters('azureClientId')]",
          "token:clientSecret": "[parameters('azureClientSecret')]",
          "token:grantType": "client_credentials"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('wdatpConnectionName'))]",
        "[resourceId('Microsoft.Web/sites/extensions', variables('functionAppName'), 'onedeploy')]"
      ],
      "tags": {
        "Vendor": "ANY.RUN",
        "Solution": "ANY.RUN Sandbox for Microsoft Defender for Endpoint",
        "Resource": "Microsoft Defender XDR",
        "PlaybookType": "Enrichment",
        "Instance": "[if(empty(parameters('instanceName')), 'default', parameters('instanceName'))]"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Triggers_-_Trigger_when_new_WDATP_alert_occurs": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['wdatp']['connectionId']"
                  }
                },
                "body": {
                  "clientState": "flow",
                  "changeType": "created",
                  "resource": "alerts",
                  "expirationDateTime": "2038-09-20T12:00:00Z",
                  "notificationUrl": "@listCallbackUrl()"
                },
                "path": "/subscriptions"
              }
            }
          },
          "actions": {
            "Alerts_-_Get_single_alert": {
              "runAfter": {},
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['wdatp']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/api/alerts/@{encodeURIComponent(triggerBody()?['id'])}"
              }
            },
            "Machines_-_Get_single_machine": {
              "runAfter": {
                "Select_Entity_Types": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['wdatp']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/api/machines/@{encodeURIComponent(body('Alerts_-_Get_single_alert')?['machineId'])}"
              }
            },
            "Retrieve_machine_os_platform_value": {
              "runAfter": {
                "Machines_-_Get_single_machine": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "machine_os_platform",
                    "type": "string",
                    "value": "@{body('Machines_-_Get_single_machine')?['osPlatform']}"
                  }
                ]
              }
            },
            "ANY.RUN_Windows_analysis_options": {
              "runAfter": {
                "ANY.RUN_general_analysis_options": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "windows_env_version",
                    "type": "string",
                    "value": "10"
                  },
                  {
                    "name": "windows_env_bitness",
                    "type": "integer",
                    "value": 64
                  },
                  {
                    "name": "windows_env_type",
                    "type": "string",
                    "value": "complete"
                  },
                  {
                    "name": "windows_obj_ext_startfolder",
                    "type": "string",
                    "value": "temp"
                  },
                  {
                    "name": "windows_obj_ext_cmd",
                    "type": "string"
                  },
                  {
                    "name": "windows_obj_force_elevation",
                    "type": "boolean",
                    "value": false
                  },
                  {
                    "name": "windows_obj_ext_browser",
                    "type": "string",
                    "value": "Microsoft Edge"
                  }
                ]
              }
            },
            "ANY.RUN_general_analysis_options": {
              "runAfter": {
                "Retrieve_machine_os_platform_value": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "opt_timeout",
                    "type": "integer",
                    "value": 240
                  },
                  {
                    "name": "opt_network_connect",
                    "type": "boolean",
                    "value": true
                  },
                  {
                    "name": "opt_network_fakenet",
                    "type": "boolean",
                    "value": false
                  },
                  {
                    "name": "opt_network_tor",
                    "type": "boolean",
                    "value": false
                  },
                  {
                    "name": "opt_network_geo",
                    "type": "string",
                    "value": "fastest"
                  },
                  {
                    "name": "opt_network_mitm",
                    "type": "boolean",
                    "value": false
                  },
                  {
                    "name": "opt_network_residential_proxy",
                    "type": "boolean",
                    "value": false
                  },
                  {
                    "name": "opt_network_residential_proxy_geo",
                    "type": "string",
                    "value": "fastest"
                  },
                  {
                    "name": "opt_privacy_type",
                    "type": "string",
                    "value": "[parameters('analysisPrivacyType')]"
                  },
                  {
                    "name": "obj_ext_extension",
                    "type": "boolean",
                    "value": true
                  },
                  {
                    "name": "env_locale",
                    "type": "string",
                    "value": "en-US"
                  },
                  {
                    "name": "user_tags",
                    "type": "string",
                    "value": "mde-alert"
                  }
                ]
              }
            },
            "ANY.RUN_Linux_analysis_options": {
              "runAfter": {
                "ANY.RUN_Windows_analysis_options": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "linux_env_os",
                    "type": "string",
                    "value": "ubuntu"
                  },
                  {
                    "name": "linux_obj_ext_startfolder",
                    "type": "string",
                    "value": "temp"
                  },
                  {
                    "name": "linux_obj_ext_cmd",
                    "type": "string"
                  },
                  {
                    "name": "linux_run_as_root",
                    "type": "boolean",
                    "value": true
                  },
                  {
                    "name": "linux_obj_ext_browser",
                    "type": "string",
                    "value": "Google Chrome"
                  }
                ]
              }
            },
            "Initialize_ANYRUN_job_tracking": {
              "runAfter": {
                "ANY.RUN_Linux_analysis_options": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "anyrun_job_id",
                    "type": "string"
                  },
                  {
                    "name": "anyrun_job_status",
                    "type": "object",
                    "value": {
                      "state": "not_started",
                      "stage": "not_started"
                    }
                  }
                ]
              }
            },
            "Check_if_the_alert_has_File_or_URL_entities": {
              "actions": {
                "Check_if_the_alert_is_from_EDR_or_Antivirus": {
                  "actions": {
                    "Is_machine_has_Windows_OS": {
                      "actions": {
                        "Execute_AnyRunDefender_using_Windows_VM": {
                          "type": "Function",
                          "inputs": {
                            "body": {
                              "alert_source": "@body('Alerts_-_Get_single_alert')?['detectionSource']",
                              "alert_id": "@body('Alerts_-_Get_single_alert')?['id']",
                              "machine_os_platform": "windows",
                              "analysis_options": {
                                "opt_network_connect": "@variables('opt_network_connect')",
                                "opt_network_fakenet": "@variables('opt_network_fakenet')",
                                "opt_network_tor": "@variables('opt_network_tor')",
                                "opt_network_geo": "@variables('opt_network_geo')",
                                "opt_network_mitm": "@variables('opt_network_mitm')",
                                "opt_network_residential_proxy": "@variables('opt_network_residential_proxy')",
                                "opt_network_residential_proxy_geo": "@variables('opt_network_residential_proxy_geo')",
                                "opt_privacy_type": "@variables('opt_privacy_type')",
                                "opt_timeout": "@variables('opt_timeout')",
                                "env_version": "@variables('windows_env_version')",
                                "env_bitness": "@variables('windows_env_bitness')",
                                "env_type": "@variables('windows_env_type')",
                                "env_locale": "@variables('env_locale')",
                                "user_tags": "@variables('user_tags')",
                                "obj_ext_extension": "@variables('obj_ext_extension')",
                                "obj_ext_startfolder": "@variables('windows_obj_ext_startfolder')",
                                "obj_ext_cmd": "@variables('windows_obj_ext_cmd')",
                                "obj_force_elevation": "@variables('windows_obj_force_elevation')",
                                "obj_ext_browser": "@variables('windows_obj_ext_browser')"
                              }
                            },
                            "function": {
                              "id": "[resourceId('Microsoft.Web/sites/functions', variables('functionAppName'), 'ANYRUN-Sandbox-MDE-FA')]"
                            },
                            "retryPolicy": {
                              "type": "none"
                            }
                          },
                          "operationOptions": "DisableAsyncPattern"
                        },
                        "Set_ANYRUN_job_id_for_Windows": {
                          "runAfter": {
                            "Execute_AnyRunDefender_using_Windows_VM": [
                              "Succeeded"
                            ]
                          },
                          "type": "SetVariable",
                          "inputs": {
                            "name": "anyrun_job_id",
                            "value": "@body('Execute_AnyRunDefender_using_Windows_VM')?['job_id']"
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Is_machine_has_Linux_OS": {
                            "actions": {
                              "Execute_AnyRunDefender_using_Linux_VM": {
                                "type": "Function",
                                "inputs": {
                                  "body": {
                                    "alert_source": "@body('Alerts_-_Get_single_alert')?['detectionSource']",
                                    "alert_id": "@body('Alerts_-_Get_single_alert')?['id']",
                                    "machine_os_platform": "linux",
                                    "analysis_options": {
                                      "opt_network_connect": "@variables('opt_network_connect')",
                                      "opt_network_fakenet": "@variables('opt_network_fakenet')",
                                      "opt_network_tor": "@variables('opt_network_tor')",
                                      "opt_network_geo": "@variables('opt_network_geo')",
                                      "opt_network_mitm": "@variables('opt_network_mitm')",
                                      "opt_network_residential_proxy": "@variables('opt_network_residential_proxy')",
                                      "opt_network_residential_proxy_geo": "@variables('opt_network_residential_proxy_geo')",
                                      "opt_privacy_type": "@variables('opt_privacy_type')",
                                      "opt_timeout": "@variables('opt_timeout')",
                                      "env_os": "@variables('linux_env_os')",
                                      "env_locale": "@variables('env_locale')",
                                      "user_tags": "@variables('user_tags')",
                                      "obj_ext_startfolder": "@variables('linux_obj_ext_startfolder')",
                                      "obj_ext_cmd": "@variables('linux_obj_ext_cmd')",
                                      "obj_ext_extension": "@variables('obj_ext_extension')",
                                      "run_as_root": "@variables('linux_run_as_root')",
                                      "obj_ext_browser": "@variables('linux_obj_ext_browser')"
                                    }
                                  },
                                  "function": {
                                    "id": "[resourceId('Microsoft.Web/sites/functions', variables('functionAppName'), 'ANYRUN-Sandbox-MDE-FA')]"
                                  },
                                  "retryPolicy": {
                                    "type": "none"
                                  }
                                },
                                "operationOptions": "DisableAsyncPattern"
                              },
                              "Set_ANYRUN_job_id_for_Linux": {
                                "runAfter": {
                                  "Execute_AnyRunDefender_using_Linux_VM": [
                                    "Succeeded"
                                  ]
                                },
                                "type": "SetVariable",
                                "inputs": {
                                  "name": "anyrun_job_id",
                                  "value": "@body('Execute_AnyRunDefender_using_Linux_VM')?['job_id']"
                                }
                              }
                            },
                            "else": {
                              "actions": {
                                "Requested_os_platform_is_not_supported_in_AnyRunDefender": {
                                  "type": "Terminate",
                                  "inputs": {
                                    "runStatus": "Cancelled"
                                  }
                                }
                              }
                            },
                            "expression": {
                              "or": [
                                {
                                  "contains": [
                                    "@variables('machine_os_platform')",
                                    "Ubuntu"
                                  ]
                                },
                                {
                                  "contains": [
                                    "@variables('machine_os_platform')",
                                    "Debian"
                                  ]
                                }
                              ]
                            },
                            "type": "If"
                          }
                        }
                      },
                      "expression": {
                        "and": [
                          {
                            "contains": [
                              "@variables('machine_os_platform')",
                              "Windows"
                            ]
                          }
                        ]
                      },
                      "type": "If"
                    }
                  },
                  "else": {
                    "actions": {
                      "Requested_alert_type_is_not_supported_in_AnyRunDefender": {
                        "type": "Terminate",
                        "inputs": {
                          "runStatus": "Cancelled"
                        }
                      }
                    }
                  },
                  "expression": {
                    "or": [
                      {
                        "equals": [
                          "@body('Alerts_-_Get_single_alert')?['detectionSource']",
                          "WindowsDefenderAtp"
                        ]
                      },
                      {
                        "equals": [
                          "@body('Alerts_-_Get_single_alert')?['detectionSource']",
                          "WindowsDefenderAv"
                        ]
                      }
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "Initialize_ANYRUN_job_tracking": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {
                  "Failed_to_find_File_or_Url_entities": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Cancelled"
                    }
                  }
                }
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@or(contains(body('Select_Entity_Types'), 'File'), contains(body('Select_Entity_Types'), 'Url'))",
                      true
                    ]
                  }
                ]
              },
              "type": "If"
            },
            "Wait_until_evidence_is_submitted_to_ANYRUN": {
              "actions": {
                "Delay_before_submission_status_check": {
                  "type": "Wait",
                  "inputs": {
                    "interval": {
                      "count": 15,
                      "unit": "Second"
                    }
                  }
                },
                "Get_ANYRUN_submission_status": {
                  "runAfter": {
                    "Delay_before_submission_status_check": [
                      "Succeeded"
                    ]
                  },
                  "type": "Function",
                  "inputs": {
                    "body": {
                      "job_id": "@variables('anyrun_job_id')"
                    },
                    "function": {
                      "id": "[resourceId('Microsoft.Web/sites/functions', variables('functionAppName'), 'ANYRUN-Sandbox-MDE-Status')]"
                    },
                    "retryPolicy": {
                      "type": "fixed",
                      "count": 3,
                      "interval": "PT5S"
                    }
                  }
                },
                "Set_ANYRUN_submission_status": {
                  "runAfter": {
                    "Get_ANYRUN_submission_status": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "anyrun_job_status",
                    "value": "@body('Get_ANYRUN_submission_status')"
                  }
                }
              },
              "runAfter": {
                "Check_if_the_alert_has_File_or_URL_entities": [
                  "Succeeded"
                ]
              },
              "expression": "@or(equals(variables('anyrun_job_status')?['state'], 'submitted_to_anyrun'), equals(variables('anyrun_job_status')?['state'], 'waiting_for_verdict'), equals(variables('anyrun_job_status')?['state'], 'analysis_completed'), equals(variables('anyrun_job_status')?['state'], 'completed'), equals(variables('anyrun_job_status')?['state'], 'failed'))",
              "limit": {
                "count": 480,
                "timeout": "PT2H"
              },
              "operationOptions": "FailWhenLimitsReached",
              "type": "Until"
            },
            "Fail_if_ANYRUN_job_failed_before_submission": {
              "actions": {
                "Terminate_failed_ANYRUN_submission": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "ANYRUNSubmissionFailed",
                      "message": "@coalesce(variables('anyrun_job_status')?['error'], 'ANY.RUN job failed before evidence submission.')"
                    }
                  }
                }
              },
              "runAfter": {
                "Wait_until_evidence_is_submitted_to_ANYRUN": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@variables('anyrun_job_status')?['state']",
                      "failed"
                    ]
                  }
                ]
              },
              "type": "If"
            },
            "Evidence_submitted_to_ANYRUN": {
              "runAfter": {
                "Fail_if_ANYRUN_job_failed_before_submission": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": {
                "job_id": "@variables('anyrun_job_id')",
                "state": "@variables('anyrun_job_status')?['state']",
                "evidence_type": "@variables('anyrun_job_status')?['latest_analysis']?['analysis_type']",
                "evidence": "@variables('anyrun_job_status')?['latest_analysis']?['evidence']",
                "sha256": "@variables('anyrun_job_status')?['latest_analysis']?['sha256']",
                "task_uuid": "@variables('anyrun_job_status')?['latest_analysis']?['task_uuid']",
                "task_url": "@variables('anyrun_job_status')?['latest_analysis']?['task_url']"
              }
            },
            "Wait_until_ANYRUN_verdict_is_available": {
              "actions": {
                "Delay_before_verdict_status_check": {
                  "type": "Wait",
                  "inputs": {
                    "interval": {
                      "count": 30,
                      "unit": "Second"
                    }
                  }
                },
                "Get_ANYRUN_verdict_status": {
                  "runAfter": {
                    "Delay_before_verdict_status_check": [
                      "Succeeded"
                    ]
                  },
                  "type": "Function",
                  "inputs": {
                    "body": {
                      "job_id": "@variables('anyrun_job_id')"
                    },
                    "function": {
                      "id": "[resourceId('Microsoft.Web/sites/functions', variables('functionAppName'), 'ANYRUN-Sandbox-MDE-Status')]"
                    },
                    "retryPolicy": {
                      "type": "fixed",
                      "count": 3,
                      "interval": "PT5S"
                    }
                  }
                },
                "Set_ANYRUN_verdict_status": {
                  "runAfter": {
                    "Get_ANYRUN_verdict_status": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "anyrun_job_status",
                    "value": "@body('Get_ANYRUN_verdict_status')"
                  }
                }
              },
              "runAfter": {
                "Evidence_submitted_to_ANYRUN": [
                  "Succeeded"
                ]
              },
              "expression": "@or(equals(variables('anyrun_job_status')?['state'], 'completed'), equals(variables('anyrun_job_status')?['state'], 'failed'))",
              "limit": {
                "count": 240,
                "timeout": "PT2H"
              },
              "operationOptions": "FailWhenLimitsReached",
              "type": "Until"
            },
            "Fail_if_ANYRUN_analysis_failed": {
              "actions": {
                "Terminate_failed_ANYRUN_analysis": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "ANYRUNAnalysisFailed",
                      "message": "@coalesce(variables('anyrun_job_status')?['error'], 'ANY.RUN analysis failed.')"
                    }
                  }
                }
              },
              "runAfter": {
                "Wait_until_ANYRUN_verdict_is_available": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@variables('anyrun_job_status')?['state']",
                      "failed"
                    ]
                  }
                ]
              },
              "type": "If"
            },
            "ANYRUN_verdict_received": {
              "runAfter": {
                "Fail_if_ANYRUN_analysis_failed": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": {
                "job_id": "@variables('anyrun_job_id')",
                "state": "@variables('anyrun_job_status')?['state']",
                "analysis_count": "@variables('anyrun_job_status')?['analysis_count']",
                "analyses": "@variables('anyrun_job_status')?['analyses']",
                "completed_at": "@variables('anyrun_job_status')?['completed_at']"
              }
            },
            "Select_Entity_Types": {
              "runAfter": {
                "Alerts_-_Get_single_alert": [
                  "Succeeded"
                ]
              },
              "type": "Select",
              "inputs": {
                "from": "@body('Alerts_-_Get_single_alert')?['evidence']",
                "select": "@item()?['entityType']"
              }
            }
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "wdatp": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('wdatpConnectionName'))]",
                "connectionName": "[variables('wdatpConnectionName')]",
                "id": "[variables('wdatpApiId')]"
              }
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "pid-TRACKING-GUID-FROM-PARTNER-CENTER",
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": []
        }
      }
    }
  ],
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[variables('functionAppName')]"
    },
    "logicAppName": {
      "type": "string",
      "value": "[variables('logicAppName')]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "instanceName": {
      "type": "string",
      "value": "[if(empty(parameters('instanceName')), 'default', parameters('instanceName'))]"
    }
  }
}
